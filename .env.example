# Copy to .env and configure. Do not commit .env or your API key.
# Leave latitude/longitude blank to use Domoticz Settings > Location.
LATITUDE=
LONGITUDE=

# Multi-array configuration: one slash-separated entry per panel group.
# PANEL_AZIMUTH uses compass bearings in multi-array mode: 0=N, 90=E, 180=S, 270=W.
# Example: 22 south-facing, 5 east-facing, 5 west-facing panels.
PANEL_DECLINATION=30/45/30
PANEL_AZIMUTH=180/90/270
PANEL_AMOUNT=22/5/5
PANEL_UNIQUE_POWER=310/305/480
# Total peak power is calculated automatically: sum(amount * unique watts) / 1000.
# Legacy single-array installations may instead use PANEL_DECLINATION=30, PANEL_AZIMUTH=0,
# and PANEL_PEAK_POWER_KWP=10.745. In legacy mode azimuth follows forecast.solar's convention.
PANEL_PEAK_POWER_KWP=

# Optional forecast.solar API key
API_KEY=

# Poll interval in minutes (minimum 5 minutes)
POLL_INTERVAL_MINUTES=10
HTTP_TIMEOUT_SECONDS=20

# ERROR, WARNING, INFO, DEBUG, TRACE
LOG_LEVEL=INFO
